{
  "name": "learning-companion",
  "productName": "Learning Companion",
  "version": "0.1.0",
  "description": "本地优先的 AI 学习助手桌面应用",
  "author": "wu-tian807",
  "main": ".vite/build/main.js",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@electron/packager@18.4.4>extract-zip": "npm:@electron-internal/extract-zip@1.0.4",
      "epubjs@0.3.93>@xmldom/xmldom": "0.8.13"
    }
  },
  "scripts": {
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:deepseek-integration": "vitest run src/main/agents/providers/codex-deepseek.integration.test.ts",
    "test:windows-integration": "vitest run src/main/external-libraries/external-command-runner.windows.integration.test.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "smoke:native": "electron scripts/better-sqlite3-smoke.mjs",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "verify:package:native": "electron scripts/verify-packaged-native.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.1",
    "@napi-rs/canvas": "1.0.2",
    "@openai/codex": "0.146.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "12.11.2",
    "better-sqlite3": "13.0.1",
    "drizzle-orm": "0.45.2",
    "electron-squirrel-startup": "1.0.1",
    "epubjs": "0.3.93",
    "iconv-lite": "^0.7.3",
    "katex": "^0.18.2",
    "openseadragon": "^6.0.2",
    "pdfjs-dist": "6.1.200",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "vditor": "3.11.2",
    "write-file-atomic": "^8.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/write-file-atomic": "^4.0.3",
    "@vitejs/plugin-react": "6.0.4",
    "electron": "43.2.0",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "4.1.10"
  }
}
